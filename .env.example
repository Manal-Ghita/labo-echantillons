# Add these keys to the local .env; preserve any existing PostgreSQL password.
# Use the same password, URL-encoded, in backend/.env DATABASE_URL.
POSTGRES_PASSWORD=

# Docker backend: random secret of at least 32 bytes, never a real value in Git.
# Copy the existing backend JWT_SECRET here locally to keep the same signing key.
JWT_SECRET=

# Docker browser URLs (public). For another hostname, update both and rebuild.
WEB_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:3000
