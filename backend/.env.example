# Copy to .env and replace placeholders locally; never commit .env.
DATABASE_URL="postgresql://labo:REPLACE_LOCALLY@localhost:5432/labo_echantillons?schema=public"
# Generate a random secret of at least 32 bytes; do not use this blank value.
JWT_SECRET=
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Set only when explicitly creating the first administrator, then remove.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: separate, already migrated database ending in _test.
# TEST_DATABASE_URL="postgresql://labo:REPLACE_LOCALLY@localhost:5432/labo_echantillons_test?schema=public"
